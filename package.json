{
  "name": "paint-by-numbers",
  "version": "1.0.0",
  "description": "A cute open-source paint-by-numbers game for little artists.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "gen": "node tools/gen.js",
    "icons": "node tools/gen-icons.js",
    "build:www": "node tools/build-www.js",
    "ios:add": "npm run build:www && npx cap add ios",
    "ios:sync": "npm run build:www && npx cap sync ios",
    "ios:assets": "npx @capacitor/assets generate --ios",
    "ios:open": "npx cap open ios"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.0"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0"
  }
}
